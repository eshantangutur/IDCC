# ---------------------------------------------------------------------------
# Argument Forensics — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# Required in production (32+ characters). Generate with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Hours a signed-in session stays valid (default 168 = 7 days)
SESSION_TTL_HOURS=168

# Set to true in production when served over HTTPS
COOKIE_SECURE=false

# Express "trust proxy" setting. 1 = trust one reverse proxy hop.
# TRUST_PROXY=1

# Comma-separated extra origins allowed to call the API. Same-origin is always allowed.
# ALLOWED_ORIGINS=https://argument-forensics.example.com

# SQLite database file for local development, relative to the project root
DATABASE_PATH=data/argument-forensics.sqlite

# Vercel cannot write a SQLite file. Create a Turso database and set both values
# in the Vercel project. Local development can leave these empty.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# AI PROVIDER
# Keys are read only by the server. Never put a key in public/ or client code.
# xAI Grok: https://console.x.ai      (keys start with xai-)
# Groq:     https://console.groq.com  (keys start with gsk_)
# ---------------------------------------------------------------------------
GROK_API_KEY=
GROQ_API_KEY=

# grok (xAI) | groq | openai-compatible | demo  (default grok)
AI_PROVIDER=grok

# xAI default. For Groq use https://api.groq.com/openai/v1
AI_BASE_URL=https://api.x.ai/v1

# xAI default. For Groq use openai/gpt-oss-120b (check the current catalogue).
AI_MODEL=grok-4.7

# Provider request limits (milliseconds / tokens)
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4500
AI_TEMPERATURE=0.2

# Ask the provider for a JSON response object. Disable if your endpoint rejects it.
AI_JSON_MODE=true

# Force demo mode even when a key exists (never sends speech text to a provider).
AI_DEMO_MODE=false

# ---------------------------------------------------------------------------
# RATE LIMITS
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30

# File uploads are read in memory and are not stored.
UPLOAD_MAX_BYTES=5242880
FILE_RATE_LIMIT_MAX=40
