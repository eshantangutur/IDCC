# ---------------------------------------------------------------------------
# Argument Forensics — production configuration template
# Copy to `.env` on the production host (never commit it).
# This file documents the production defaults; changing it does nothing.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Bind to loopback and let a TLS-terminating reverse proxy expose the app.
PORT=3000
HOST=127.0.0.1

# REQUIRED. 32+ characters. Generate one:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# HTTPS-only cookies. Keep true in production.
COOKIE_SECURE=true

# One trusted reverse-proxy hop (nginx/Caddy on the same host).
TRUST_PROXY=1

# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# Only needed if the frontend is served from a different origin.
ALLOWED_ORIGINS=

# Durable path on the production volume, relative to the project root.
DATABASE_PATH=data/argument-forensics.sqlite

# ---------------------------------------------------------------------------
# AI (server-side only — never put this key in public/)
# xAI keys start with xai-; Groq keys start with gsk_. Set only the one you use.
# ---------------------------------------------------------------------------
GROK_API_KEY=
GROQ_API_KEY=
# grok (xAI) | groq | openai-compatible | demo
AI_PROVIDER=grok
# For Groq use https://api.groq.com/openai/v1 and openai/gpt-oss-120b.
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.7
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4500
AI_JSON_MODE=true
AI_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Rate limits (per process; use a shared store for multiple instances)
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30

LOG_LEVEL=info
